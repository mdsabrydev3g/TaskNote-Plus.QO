# TaskNote Plus — environment template. Copy to .env and fill values.
# Get DATABASE_URL from Neon dashboard (use the *pooled* (-pooler) string on Vercel).

# PostgreSQL 16 / Neon
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret for signing JWT access tokens — generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-secret"

# Public origin of the deployed app (used for PWA + Capacitor server URL)
NEXT_PUBLIC_APP_URL="https://tasknote-plus.vercel.app"
